variant: fcos
version: 1.7.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFC7kDA/fuEqK0xwY78BylOB2Z6VwJKVU+pmj/bAJx2i
    - name: sleeper
storage:
  directories:
    # sleeper
    - path: /home/sleeper/.config
      mode: 0755
      user:
        name: sleeper
      group:
        name: sleeper
    - path: /home/sleeper/.config/systemd
      mode: 0755
      user:
        name: sleeper
      group:
        name: sleeper
    - path: /home/sleeper/.config/systemd/user
      mode: 0755
      user:
        name: sleeper
      group:
        name: sleeper
    - path: /home/sleeper/.config/systemd/user/default.target.wants
      mode: 0755
      user:
        name: sleeper
      group:
        name: sleeper
    - path: /home/sleeper/.config/containers
      mode: 0755
      user:
        name: sleeper
      group:
        name: sleeper
  files:
    # sleeper
    - path: /var/lib/systemd/linger/sleeper
      mode: 0644
    - path: /home/sleeper/.config/systemd/user/update-manifests.service
      mode: 0755
      user:
        name: sleeper
      group:
        name: sleeper
      contents:
        inline: |
          [Unit]
          Description=Update manifests

          [Service]
          Type=oneshot
          ExecStart=/usr/bin/bash -c 'if [ -d "$HOME/.config/containers/systemd/.git" ]; then cd "$HOME/.config/containers/systemd" && git pull --ff-only; else git clone https://github.com/nivalunaa/containers.git "$HOME/.config/containers/systemd"; fi && systemctl --user daemon-reload'
    - path: /home/sleeper/.config/systemd/user/update-manifests.timer
      mode: 0755
      user:
        name: sleeper
      group:
        name: sleeper
      contents:
        inline: |
          [Unit]
          Description=Update manifests every 5 minutes

          [Timer]
          OnBootSec=2min
          OnUnitActiveSec=5min
          Persistent=true

          [Install]
          WantedBy=timers.target
    # system
    - path: /etc/zincati/config.d/90-periodic-updates.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [updates.periodic]
          time_zone = "Europe/Helsinki"

          [[updates.periodic.window]]
          window_start = "01:00"
          window_length_minutes = 240

  links:
    # sleeper
    - path: /home/sleeper/.config/systemd/user/default.target.wants/update-manifests.timer
      user:
        name: sleeper
      group:
        name: sleeper
      target: /home/sleeper/.config/systemd/user/update-manifests.timer
      hard: false
